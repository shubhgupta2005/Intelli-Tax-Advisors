{
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/workdesk.py": {
      "maxDuration": 60
    },
    "api/expenseflow.py": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/workspace",
      "destination": "/workspace/",
      "permanent": true
    },
    {
      "source": "/workspace/expenses",
      "destination": "/workspace/expenses/",
      "permanent": true
    },
    {
      "source": "/employeeworkspace",
      "destination": "/workspace/",
      "permanent": true
    },
    {
      "source": "/employeeworkspace/(.*)",
      "destination": "/workspace/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/workspace/expenses/api/:path*",
      "destination": "/api/expenseflow"
    },
    {
      "source": "/workspace/api/:path*",
      "destination": "/api/workdesk"
    },
    {
      "source": "/workspace/receipts/:path*",
      "destination": "/api/workdesk"
    },
    {
      "source": "/workspace/receipts-scan/:path*",
      "destination": "/api/workdesk"
    },
    {
      "source": "/workspace/chat-files/:path*",
      "destination": "/api/workdesk"
    },
    {
      "source": "/workspace/client-docs/:path*",
      "destination": "/api/workdesk"
    }
  ],
  "headers": [
    {
      "source": "/workspace/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/workspace/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/workspace/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/workspace/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/workspace/expenses/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/workspace/expenses/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/workspace/api/cron/backup",
      "schedule": "30 20 * * *"
    }
  ]
}
